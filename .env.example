POSTGRES_DB=tixora
POSTGRES_USER=tixora
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe
# Au moins 32 caracteres, genere avec : openssl rand -base64 48
JWT_SECRET=remplacer_par_un_secret_long_et_aleatoire_de_48_caracteres_minimum
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# URL publique du frontend : sert aux liens de partage (apercu WhatsApp/Facebook/X)
APP_PUBLIC_URL=http://localhost:8081
# Compte administrateur cree au demarrage s'il n'existe pas (mot de passe : 8 caracteres minimum)
ADMIN_EMAIL=admin@tixora.cm
ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_admin
# true : cree un organisateur, un client et des evenements de demonstration (base vide uniquement)
SEED_DEMO=true
# Fuseau qui decide quand un evenement est termine (verrouille)
APP_TIMEZONE=Africa/Douala

# --- Paiement CT Pay -------------------------------------------------------------------------------
# simulate : aucun appel reseau, aucun debit (le paiement reussit apres 4 s ; echec si le numero finit par 00)
# live     : paiements reels via CT Pay (exige CTPAY_TOKEN)
CTPAY_MODE=simulate
# Token marchand CT Pay : SECRET, uniquement lu par le backend, ne jamais le commiter ni le mettre dans le frontend
CTPAY_TOKEN=
CTPAY_BASE_URL=https://gateway-prod.connecttechnology.io
# Frais CT Pay (%) : CT Pay les ajoute au montant, le client paie prix + frais (estimation d'affichage)
CTPAY_FEE_PERCENT=4.78
# Operateurs proposes aux clients
CTPAY_OPERATORS=MOMO,OM
# Commission de Tixora (%) sur les ventes de billets
COMMISSION_PERCENT=10
# URL publique HTTPS de l'API (callback CT Pay), ex. https://tixora-api.onrender.com . Vide en local.
API_PUBLIC_URL=
# Minutes laissees au client pour valider le paiement sur son telephone
ORDER_TTL_MINUTES=10

# --- Connexion Google (Client ID OAuth "Application Web", identifiant public). Vide = bouton masque ---
GOOGLE_CLIENT_ID=

# --- Recherche precise des lieux (SerpApi) : SECRET, uniquement lu par le backend. Vide = repli OpenStreetMap ---
SERPAPI_KEY=

