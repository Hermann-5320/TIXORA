# Dockerfile pour Render (build simple, sans cache BuildKit). En local, utiliser le Dockerfile habituel.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package

FROM eclipse-temurin:21-jre
RUN useradd --system --no-create-home appuser
WORKDIR /app
COPY --from=build /app/target/tixora-api-1.0.0.jar app.jar
USER appuser
EXPOSE 8080
# Petite instance (512 Mo) : 70 % de la memoire pour la JVM
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "app.jar"]
